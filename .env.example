TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-read-write-token

# Meta Business Manager -> Events Manager -> your Pixel -> Settings -> Conversions API
# Leave as DUMMY_* (or unset) to run the tracker without forwarding to Meta.
META_PIXEL_ID=DUMMY_PIXEL_ID
META_CAPI_ACCESS_TOKEN=DUMMY_ACCESS_TOKEN
